  <Window x:Class="FindStrFrontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FindStrFrontend"
        mc:Ignorable="d"
        Title="FindStr Frontend" Height="550" Width="725"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">
    
      
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Export Results" Click="Export_Click"/>
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Show _Command" Click="ShowCommand_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="About_Click"/>
            </MenuItem>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0">
                <ProgressBar x:Name="progressBar" IsIndeterminate="False" Maximum="1" Width="100" Height="16" />
            </StatusBarItem>
            <Separator Grid.Column="1" />
            <StatusBarItem Grid.Column="2">
                <TextBlock>Total Matches:</TextBlock>
            </StatusBarItem>
            <StatusBarItem Grid.Column="3">
                <TextBlock x:Name="totalMatches">0</TextBlock>
            </StatusBarItem>
        </StatusBar>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Search GroupBox -->
            <GroupBox Header="Search" Grid.Row="0" Margin="0,0,0,6" Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Content="Search String" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" />
                    <TextBox x:Name="Needle" Grid.Column="1" Grid.Row="0" Margin="0,4" />

                    <Label Content="Base Directory" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" />
                    <DockPanel Grid.Column="1" Grid.Row="1" Margin="0,4">
                        <Button DockPanel.Dock="Left" Click="DirectoryChoose_Click" MouseRightButtonUp="DirectoryChoose_RightClick" 
                                MinWidth="75" Margin="0,0,8,0" ToolTip="Left-click for folder picker, right-click for file picker">Browse...</Button>
                        <TextBox x:Name="SourceDirectory">C:\</TextBox>
                    </DockPanel>

                    <Label Content="File Filter" Grid.Column="0" Grid.Row="2" VerticalAlignment="Center" />
                    <TextBox x:Name="FileFilter" Grid.Column="1" Grid.Row="2" Width="180" HorizontalAlignment="Left" Margin="0,4"
                             ToolTip="File name pattern, e.g. *.cs, *.txt">*</TextBox>
                </Grid>
            </GroupBox>

            <!-- Options GroupBox -->
            <GroupBox Header="Options" Grid.Row="1" Margin="0,0,0,6" Padding="8,6">
                <StackPanel Orientation="Vertical">
                    <CheckBox x:Name="Recursive" IsChecked="True">Recursive</CheckBox>
                    <CheckBox x:Name="CaseSensitive" IsChecked="False">Case Sensitive</CheckBox>
                    <CheckBox x:Name="Literal" IsChecked="False">Literal (Include Whitespace, etc.)</CheckBox>
                    <CheckBox x:Name="SkipBinary" IsChecked="True">Skip Binary Files</CheckBox>
                    <CheckBox x:Name="RegularExpressions" IsChecked="False">Use Regular Expressions</CheckBox>
                </StackPanel>
            </GroupBox>

            <!-- Search Button -->
            <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Center" Margin="0,6,0,10">
                <Button x:Name="SearchButton" Click="Search_Click" Padding="24,6" MinWidth="120" IsDefault="True" FontWeight="SemiBold">Search</Button>
            </StackPanel>

            <!-- Results GroupBox -->
            <GroupBox Header="Results" Grid.Row="3" Padding="0">
                <ListView x:Name="outputBox" ItemsSource="{Binding resultLines}" BorderThickness="0"
                          MouseDoubleClick="OpenWithDefaultViewer_Click" AlternationCount="2">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Style.Triggers>
                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#F7F7F7" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="File" DisplayMemberBinding="{Binding File}" Width="200"/>
                            <GridViewColumn Header="Line" DisplayMemberBinding="{Binding Line}" Width="60"/>
                            <GridViewColumn Header="Contents" DisplayMemberBinding="{Binding Contents}" Width="400"/>
                        </GridView>
                    </ListView.View>
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open with Default Viewer" Click="OpenWithDefaultViewer_Click" />
                            <MenuItem Header="Show in Explorer" Click="ShowInExplorer_Click" />
                            <MenuItem Header="Open in Notepad" Click="OpenInNotepad_Click" />
                            <MenuItem Header="Open in Notepad++" Click="OpenInNotepadPlusPlus_Click" />
                            <MenuItem Header="Open in Notepad++ (Admin)" Click="OpenInNotepadPlusPlusAdmin_Click" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                </ListView>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
